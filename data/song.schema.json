{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sguzman.github.io/music-gallery/data/song.schema.json",
  "title": "Music Gallery Song",
  "type": "object",
  "required": [
    "schemaVersion",
    "slug",
    "identity",
    "origin",
    "arrangement",
    "musical",
    "playback",
    "taxonomy",
    "verification",
    "presentation",
    "sections"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "identity": {
      "type": "object",
      "required": [
        "title",
        "displayTitle",
        "composer"
      ]
    },
    "origin": {
      "type": "object",
      "required": [
        "category",
        "era",
        "sourceMedium"
      ]
    },
    "arrangement": {
      "type": "object",
      "required": [
        "type",
        "targetInstrument",
        "tuning",
        "difficulty",
        "handPositions"
      ]
    },
    "musical": {
      "type": "object",
      "description": "Timing grid. defaultBpm is a quarter-note-equivalent tempo. unitsPerQuarter declares how many event-grid units equal one quarter note; playback seconds per event unit are 60 / defaultBpm / unitsPerQuarter.",
      "required": [
        "meter",
        "tempoUnit",
        "unitsPerQuarter",
        "defaultBpm",
        "bpmRange"
      ],
      "properties": {
        "meter": {
          "type": "string"
        },
        "tempoUnit": {
          "type": "string",
          "description": "Human-readable source/original tempo-unit note when useful."
        },
        "unitsPerQuarter": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Number of event-grid units per quarter note. Example: 2 means each event unit is an eighth-note-equivalent at constant tempo."
        },
        "defaultBpm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Quarter-note-equivalent BPM used by the site clock."
        },
        "bpmRange": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "description": "Recommended/reference musical tempo range. This is metadata for practice/source context, not the hard transport-control limit."
        }
      }
    },
    "playback": {
      "type": "object",
      "required": [
        "instrumentOptions",
        "midiExport",
        "synchronizedHighlighting"
      ]
    },
    "taxonomy": {
      "type": "object"
    },
    "verification": {
      "type": "object"
    },
    "presentation": {
      "type": "object",
      "required": [
        "accent",
        "description"
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "parts": {
      "type": "array",
      "description": "Optional simultaneous musical parts for mini-orchestra playback. Legacy melody-only songs omit this and use top-level sections.",
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "fullVersion": {
      "$ref": "#/$defs/fullVersion"
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": [
        "type",
        "start",
        "duration"
      ],
      "properties": {
        "type": {
          "enum": [
            "note",
            "rest"
          ]
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "string": {
          "enum": [
            "e",
            "B",
            "G",
            "D",
            "A",
            "E"
          ]
        },
        "stringIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "fret": {
          "type": "integer",
          "minimum": 0
        },
        "midi": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "position": {
          "enum": [
            "open",
            "low",
            "mid",
            "upper",
            "high"
          ]
        },
        "anchor": {
          "type": "boolean"
        }
      }
    },
    "measure": {
      "type": "object",
      "required": [
        "label",
        "duration",
        "events"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "name",
        "measures"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "measures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measure"
          }
        }
      }
    },
    "part": {
      "type": "object",
      "required": [
        "id",
        "name",
        "sections"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "defaultInstrument": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "tab": {
          "type": "boolean",
          "description": "Whether this part drives the visible guitar-tab cursor."
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "fullEvent": {
      "type": "object",
      "required": [
        "type",
        "start",
        "duration",
        "midi"
      ],
      "properties": {
        "type": {
          "const": "note"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "midi": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "sourceMeasure": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "description": "Source measure label; string form preserves pickups, suffixes, and non-numeric edition labels."
        },
        "sourceMeasureIndex": {
          "type": "integer",
          "minimum": 0
        },
        "sourceVoice": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "sourceStaff": {
          "type": "integer",
          "minimum": 1
        },
        "grace": {
          "type": "boolean"
        },
        "velocity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "sourceTrack": {
          "type": "integer",
          "minimum": 0
        },
        "sourceChannel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        }
      }
    },
    "fullTrack": {
      "type": "object",
      "required": [
        "id",
        "name",
        "defaultInstrument",
        "events"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "instrumentLabel": {
          "type": "string"
        },
        "defaultInstrument": {
          "type": "string"
        },
        "gmProgram": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "enabled": {
          "type": "boolean"
        },
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fullEvent"
          }
        },
        "pan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "clef": {
          "type": "string"
        },
        "sourcePartId": {
          "type": "string"
        },
        "sourceStaff": {
          "type": "integer",
          "minimum": 1
        },
        "sourceTrackIndex": {
          "type": "integer",
          "minimum": 0
        },
        "sourceChannels": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          }
        }
      }
    },
    "fullVersion": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "source-ready",
            "transcription-ready",
            "audio-reconstruction-ready",
            "publication-rights-review",
            "planned",
            "blocked-rights"
          ]
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fidelity": {
          "type": "string"
        },
        "musical": {
          "type": "object",
          "properties": {
            "meter": {
              "type": "string"
            },
            "tempoUnit": {
              "type": "string"
            },
            "unitsPerQuarter": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "defaultBpm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "bpmRange": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "tempoStanding": {
              "type": "string"
            }
          }
        },
        "durationUnits": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "measures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "start",
              "duration"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "provenance": {
          "type": "object"
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fullTrack"
          }
        },
        "artifactPath": {
          "type": "string",
          "pattern": "^data/ingested/[a-z0-9-]+\\.full\\.json$",
          "description": "Optional external normalized Full Rendition artifact loaded by the song page at runtime."
        }
      }
    }
  }
}
